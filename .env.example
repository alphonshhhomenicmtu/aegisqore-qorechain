# QoreGuard Environment Configuration (NEVER commit real keys!)
# Network preset: testnet | mainnet | localnet
QOREGUARD_NETWORK=testnet

# Optional endpoint overrides (defaults to official public QoreChain testnet endpoints)
QOREGUARD_EVM_RPC_URL=https://evm-testnet.qore.host
QOREGUARD_RPC_URL=https://rpc-testnet.qore.host
QOREGUARD_REST_URL=https://api-testnet.qore.host

# Turnkey guarded transaction runner (default dry-run = true; safe offline fallback)
QOREGUARD_DRY_RUN=true
# Provide a 0x-prefixed 32-byte EVM private key ONLY in local untracked .env for live broadcast
# QOREGUARD_PRIVATE_KEY=
# Recipient 0x address (must be allowlisted in the active QoreGuard policy)
QOREGUARD_TO=0x000000000000000000000000000000000000dEaD
# Transfer amount in uqor / wei (decimal string)
QOREGUARD_VALUE_UQOR=100000
